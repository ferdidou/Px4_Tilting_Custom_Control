#!/bin/sh
#
# @name Mini-Tilt Hexa SITL (SMART/Saxion, 6 arms, 1 rotor + 1 tilt servo per arm)
#
# @type Tilting Multirotor
# @class Copter
#
# @output MAIN1 motor 1
# @output MAIN2 motor 2
# @output MAIN3 motor 3
# @output MAIN4 motor 4
# @output MAIN5 motor 5
# @output MAIN6 motor 6
# @output MAIN7 tilt servo 1
# @output MAIN8 tilt servo 2
# @output MAIN9 tilt servo 3
# @output MAIN10 tilt servo 4
# @output MAIN11 tilt servo 5
# @output MAIN12 tilt servo 6
#
# @maintainer Ferdi <ckferdi68@gmail.com>
#
# SITL model of the Mini-Tilt Drone. Hardware airframe: 25006_mini_tilt_hexa.
#

. ${R}etc/init.d/rc.mc_defaults

param set-default CA_AIRFRAME 13 #Tilting Multirotor
param set-default CA_TILTING_TYPE 1 #Tilting Multirotor

set MAV_TYPE 13

set PWM_OUT 12345678
set PWM_AUX_OUT 1234

param set-default CA_ROTOR_COUNT 6
param set-default CA_SV_TL_COUNT 6

param set-default CA_ROTOR0_PX 0.0000  #90 deg  CW
param set-default CA_ROTOR0_PY 0.1753
